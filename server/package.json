{
	"name": "@coub-downloader/server",
	"version": "0.1.0",
	"description": "Download favorite and liked coubs into local html file",
	"private": true,
	"author": "Anatoliy Oblaukhov",
	"homepage": "https://github.com/anmiles/coub-downloader/tree/main/server",
	"repository": "github:anmiles/coub-downloader",
	"license": "MIT",
	"engines": {
		"node": ">=24.18.0"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc -p ./tsconfig.build.json",
		"test": "jest --verbose",
		"test:coverage": "npm test -- --coverage",
		"test:ci": "npm test -- --ci --coverage",
		"test:watch": "npm test -- --watch",
		"test:watch:coverage": "npm test -- --watch --coverage",
		"test:report:coverage": "nyc report",
		"start": "node ./dist/index.js",
		"create": "node ./dist/create.js"
	},
	"dependencies": {
		"@anmiles/downloader": "^6.0.4",
		"@anmiles/express-tools": "^2.1.0",
		"@anmiles/logger": "^9.0.0",
		"@anmiles/prototypes": "^12.0.0",
		"@anmiles/sleep": "^5.0.4",
		"@anmiles/zod-tools": "^1.2.0",
		"@coub-downloader/shared": "*",
		"lodash": "^4.18.1"
	},
	"devDependencies": {
		"@anmiles/jest-extensions": "^6.1.5",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.25",
		"@types/mock-fs": "^4.13.4",
		"jest": "^30.5.1",
		"mock-fs": "^5.5.0",
		"nyc": "^18.0.0",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.3"
	}
}
